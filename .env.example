# ──────────────────────────────────────────────
# Kitch-A Backend — Environment Variables
# Salin file ini jadi .env dan isi nilainya
# ──────────────────────────────────────────────

# PostgreSQL dari Supabase
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection String → URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Secret untuk signing JWT — boleh string random panjang
JWT_SECRET="ganti_dengan_string_random_yang_panjang_dan_aman"

# Berapa lama token berlaku (contoh: 30d, 7d, 24h)
JWT_EXPIRES_IN="30d"

# Gemini API Key — pindah dari Flutter ke sini agar aman
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Port server (Railway/Render otomatis set ini)
PORT=3000
