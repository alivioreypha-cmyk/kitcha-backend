// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Bunda")
  phone        String   @default("")
  profileImage String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  foods FoodItem[]

  @@index([email])
}

model FoodItem {
  id                    String   @id
  name                  String
  expiryDate            DateTime
  imagePath             String   @default("")
  storageRecommendation String   @default("")
  wasteCategory         String   @default("loading")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index utama: query getAllFoods selalu filter by userId + sort by expiryDate
  @@index([userId, expiryDate])
  // Index tambahan: filter by wasteCategory per user
  @@index([userId, wasteCategory])
}
