// prisma/schema.prisma
// Jalankan: npx prisma db push  (untuk sync ke Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Bunda")
  phone        String   @default("")
  profileImage String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  foods FoodItem[]
}

model FoodItem {
  id                    String   @id
  name                  String
  expiryDate            DateTime
  imagePath             String   @default("")
  storageRecommendation String   @default("")
  wasteCategory         String   @default("loading")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
